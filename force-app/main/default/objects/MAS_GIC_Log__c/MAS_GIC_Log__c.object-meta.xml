<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Execution log for a Mass Action Scheduler run: one summary record per run plus optional per-batch error records.</description>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <label>MAS Log</label>
    <pluralLabel>MAS Logs</pluralLabel>
    <nameField>
        <label>Log Number</label>
        <type>AutoNumber</type>
        <displayFormat>LOG-{000000}</displayFormat>
    </nameField>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
